# Copy to .env.local for local development, and add the same keys in
# Cloudflare Pages > Settings > Variables and secrets (Production + Preview).
#
# These values come from Firebase console > Project settings > General > Your apps > Web app.
# They are NOT secrets: they identify your project to the browser SDK. Access control is
# enforced by Firestore Security Rules (owner UID allowlist), not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Show the "Create account" form on the sign-in page. Enable only while bootstrapping
# the owner account (or create the user in the Firebase console instead), then set false.
VITE_ALLOW_SIGNUP=false

# Show the "Continue with Google" button. Enable after turning on the Google provider in Firebase.
VITE_ENABLE_GOOGLE_SIGNIN=false

# Connect to local Firebase emulators instead of the real project (development only).
VITE_USE_EMULATORS=false
