# Copy to .env.local for local development and production builds.
#
# These values come from Firebase console > Project settings > General > Your apps > Web app
# (or: npx firebase apps:sdkconfig WEB --project <project-id>).
# They are NOT secrets: they identify your project to the browser SDK. Access control is
# enforced by Firestore Security Rules (owner UID allowlist + Google sign-in), not by hiding them.
VITE_FIREBASE_API_KEY=
# Keep <project-id>.firebaseapp.com unless the app is served from a domain on Firebase Hosting
# that you have set up as the auth domain (see docs/DEPLOYMENT.md).
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Connect to local Firebase emulators instead of the real project (development only).
VITE_USE_EMULATORS=false

# AI assistant — Cloudflare Worker proxy (server-to-server to Bedrock gateway).
# Deploy: cd workers/hub-ai-proxy && npx wrangler login && npm i && npm run secret:url && npm run secret:key && npm run deploy
# Browser calls this URL directly in production (Firebase Hosting would rewrite /ai-proxy to index.html).
# Do NOT put the Bedrock gateway key in production builds — the Worker holds it.
VITE_AI_PROXY_URL=https://personal-hub-ai-proxy.<your-subdomain>.workers.dev/v1
VITE_AI_MODEL=anthropic.claude-sonnet-4-6
# VITE_AI_MAX_TOKENS=2048
#
# Local-only (Vite proxies /ai-proxy → CloudFront). Keep the key out of production builds when using the Worker:
# VITE_AI_BASE_URL=https://d2cmgqlwjalmr4.cloudfront.net/v1
# VITE_AI_API_KEY=

# Voice (Gemini TTS) is configured on the Worker — never in the browser:
#   cd workers/hub-ai-proxy
#   npx wrangler secret put GEMINI_API_KEY
# Optional Worker vars (wrangler.toml): GEMINI_TTS_MODEL, GEMINI_TTS_FALLBACK_MODEL, GEMINI_VOICE,
# GEMINI_DAILY_TOKEN_LIMIT, GEMINI_DAILY_REQUEST_LIMIT, GEMINI_RPM
# Mic input uses the device Speech Recognition API; TTS falls back to device speechSynthesis when limited.


